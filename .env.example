# Copiar a .env y rellenar. El .env NUNCA se commitea.

# Base de datos
POSTGRES_DB=atlasram
POSTGRES_USER=atlasram
POSTGRES_PASSWORD=cambiar_en_local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/atlasram
SPRING_DATASOURCE_USERNAME=atlasram
SPRING_DATASOURCE_PASSWORD=cambiar_en_local

# JWT — generar con: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Correo
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Almacenamiento de archivos
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
